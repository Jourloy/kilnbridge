      ]
    }
  ],
  "testCommands": [
    {
      "run": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/test.ps1"
      ]
    }
  ]
}
