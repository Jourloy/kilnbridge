# Copy to agent.env and paste these values from the Windows app's Connection screen.
# These three values are enough to build, keep results on the agent, and download them.
KILNBRIDGE_URL="https://192.168.1.50:8743"
KILNBRIDGE_KEY="replace-with-your-agent-key"
KILNBRIDGE_PIN_SHA256="replace-with-the-certificate-fingerprint"

# Optional Flutter API_URL define:
# API_URL="https://api.example.com"

# Only for publish: s3. The bucket must already exist.
# MINIO_ENDPOINT="https://minio.example.com"
# MINIO_BUCKET="releases"
# MINIO_REGION="us-east-1"
# MINIO_ACCESS_KEY_ID="replace-with-your-access-key"
# MINIO_SECRET_ACCESS_KEY="replace-with-your-secret-key"
# MINIO_PREFIX="release-candidates"
# MINIO_SESSION_TOKEN="optional-temporary-credential-token"

# Only for publish: github. Grant repository Contents write permission.
# KILNBRIDGE_GITHUB_TOKEN="replace-with-your-token"
